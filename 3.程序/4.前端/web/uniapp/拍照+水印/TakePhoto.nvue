import { onHide } from "@dcloudio/uni-app"

<template>

  <view class="view_page" :style="{ width: windowWidth, height: windowHeight }">

      <!-- #ifdef APP-PLUS || MP-WEIXIN -->
      <live-pusher id="livePusher" ref="livePusher" mode="FHD" beauty="0" whiteness="0" :aspect="aspect"
        min-bitrate="1000" audio-quality="16KHz" device-position="back" :auto-focus="true" :muted="true"
        :enable-camera="enableCamera" :enable-mic="false" :zoom="false" @statechange="onStatechange"
        :style="{ width: windowWidth, height: windowHeight }"></live-pusher>
      <!-- #endif -->

      <!-- #ifndef APP-PLUS || MP-WEIXIN -->
      <cover-view class="h5-camera-placeholder">
        <text>请在App或小程序中使用相机功能</text>
      </cover-view>
      <!-- #endif -->


    <cover-view  class=" view_container" :style="{ width: windowWidth, height: windowHeight }">

      <!-- 水印 -->
      <cover-view class="watermark">
        <text class="watermark-item">{{ address }}</text>
        <text class="watermark-item">{{ currentTime }}</text>
        <text class="watermark-item">
          {{ userInfo.realname }} {{ userInfo.employeeId }}
        </text>
      </cover-view>


        <!-- 控制栏 -->
        <cover-view class="control-bar">
          <cover-view class="btn  empty-btn"></cover-view>
          <cover-image class="btn take-btn" @click="takePhoto" src="/static/live-camera/shutter.png"></cover-image>
          <cover-image class="btn flip-btn" @click="flip" src="/static/live-camera/flip.png"></cover-image>
        </cover-view>

      
    </cover-view>
  </view>

</template>

  <script>
  export default {
    data() {
      return {
        userInfo: {
          realname: '张三',
          employeeId: '1001',
        },
        flashMode: 'off',
        frontCamera: true,
        currentTime: '',
        address: '定位中...',
        previewImage: '',
        originalImage: '',
        fromPage: '',
        intervalId: null,

        openCarmeInterval: null, // 打开相机的轮询
        aspect: '2:3', // 比例
        windowWidth: 0, // 屏幕可用宽度
        windowHeight: 0, // 屏幕可用高度
        camerastate: false, // 相机准备好了
        livePusher: null, // 流视频对象
        snapshotsrc: null, // 快照
        enableCamera: true // 是否启用相机
      }
    },
    onLoad(options) {
      this.fromPage = options.from || ''
      this.initCamera()
      this.checkPermissions()
    },
    onReady() {
      // 确保DOM渲染完成后再创建livePusher实例
      this.$nextTick(() => {
        this.livePusher = uni.createLivePusherContext('livePusher', this);
        this.startPreview(); // 开启预览并设置摄像头
      })
    },
    onShow() {
      // 监听从 PreviewPhoto 返回的结果
      // 假设 PreviewPhoto 页面在用户确认后会触发 uni.$emit('previewResult', data)
      // 如果使用的是 navigateBack 的 success 回调中 emit，这里可以接收到
      uni.$on('previewResult', this.handlePreviewResult);
      // this.startPreview()
      this.startUpdateTime()
    },
    onHide() {
      this.stopUpdateTime()
    },
    onUnload() {
      // 移除事件监听，防止内存泄漏
      uni.$off('previewResult', this.handlePreviewResult);
      this.stopPreview()
    },
    methods: {
      // openCarme() {
      //   //#ifdef APP-PLUS
      //   const _this = this;
      //   if (!this.openCarmeInterval) {
      //     this.openCarmeInterval = setInterval(function () {
      //       console.log(_this.camerastate);
      //       if (!_this.camerastate) _this.startPreview();
      //     }, 2500);
      //   }
      //   //#endif
      // },

      // 初始化相机
      initCamera() {
        const _this = this;
        uni.getSystemInfo({
          success: function (res) {
            // 使用安全区域尺寸，确保完全覆盖屏幕
            _this.windowWidth = res.windowWidth;
            _this.windowHeight = res.windowHeight;
            let zcs = _this.aliquot(_this.windowWidth, _this.windowHeight);
            _this.aspect = (_this.windowWidth / zcs) + ':' + (_this.windowHeight / zcs);
            console.log('画面比例：' + _this.aspect);
          }
        });
      },

      // 整除数计算
      aliquot(x, y) {
        if (x % y == 0) return y;
        return this.aliquot(y, x % y);
      },

      // 开始预览
      startPreview() {
        if (this.livePusher) {
          this.livePusher.startPreview({
            success: a => {
              console.log('开始预览成功', a)
            },
            fail: err => {
              console.error('开始预览失败', err)
            }
          });
        }
      },

      // 停止预览
      stopPreview() {
        if (this.livePusher) {
          this.livePusher.stopPreview({
            success: a => {
              this.camerastate = false; // 标记相机未启动
              console.log('停止预览成功', a)
            },
            fail: err => {
              console.error('停止预览失败', err)
            }
          });
        }
      },

      // 状态
      onStatechange(e) {
        // 状态改变
        console.log('相机状态变化:', e);
        if (e.detail.code == 1007) {
          this.camerastate = true;
        } else if (e.detail.code == -1301) {
          this.camerastate = false;
        }
      },

      // 反转
      flip() {
        if (this.livePusher) {
          this.livePusher.switchCamera();
        }
      },

      // 初始化水印
      startUpdateTime() {
        this.updateTime()
        this.stopUpdateTime()
        this.intervalId = setInterval(() => {
          this.updateTime()
        }, 1000)
      },

      stopUpdateTime() {
        if(this.intervalId){
          clearInterval(this.intervalId)
          this.intervalId = null
        }
      },

      // 更新时间
      updateTime() {
        const date = new Date()
        const year = date.getFullYear()
        const month = String(date.getMonth() + 1).padStart(2, '0')
        const day = String(date.getDate()).padStart(2, '0')
        const hours = String(date.getHours()).padStart(2, '0')
        const minutes = String(date.getMinutes()).padStart(2, '0')
        const seconds = String(date.getSeconds()).padStart(2, '0')
      
        this.currentTime = `${year}-${month}-${day} ${hours}:${minutes}:${seconds}`
      },

      // 检查权限
      checkPermissions() {
        this.checkCameraPermission()
        this.checkLocationPermission()
      },

      // 检查相机权限
      checkCameraPermission() {
        // #ifdef APP-PLUS
        // Android平台直接启动相机
        this.startCamera()
        // #endif
        // #ifdef MP-WEIXIN || H5
        uni.getSetting({
          success: (res) => {
            if (!res.authSetting['scope.camera']) {
              uni.authorize({
                scope: 'scope.camera',
                success: () => {
                  this.startCamera()
                },
                fail: () => {
                  uni.showModal({
                    title: '权限提示',
                    content: '需要相机权限才能进行拍照',
                    confirmText: '去设置',
                    cancelText: '取消',
                    success: (res) => {
                      if (res.confirm) {
                        uni.openSetting()
                      }
                    },
                  })
                },
              })
            } else {
              this.startCamera()
            }
          },
          fail: () => {
            // 获取设置失败时直接启动相机
            this.startCamera()
          },
        })
        // #endif
      },

      // 检查定位权限
      checkLocationPermission() {
        // #ifdef APP-PLUS
        // Android平台直接获取定位
        this.getLocation()
        // #endif
        // #ifdef MP-WEIXIN || H5
        uni.getSetting({
          success: (res) => {
            if (!res.authSetting['scope.userLocation']) {
              uni.authorize({
                scope: 'scope.userLocation',
                success: () => {
                  this.getLocation()
                },
                fail: () => {
                  uni.showModal({
                    title: '权限提示',
                    content: '需要定位权限才能显示位置信息',
                    confirmText: '去设置',
                    cancelText: '取消',
                    success: (res) => {
                      if (res.confirm) {
                        uni.openSetting()
                      }
                    },
                  })
                },
              })
            } else {
              this.getLocation()
            }
          },
          fail: () => {
            // 获取设置失败时直接获取定位
            this.getLocation()
          },
        })
        // #endif
      },

      // 启动相机
      startCamera() {
        // 由于使用了 live-pusher 组件，这里只需确保组件已经正确初始化
        console.log("准备启动相机");
      },

      // 获取定位
      getLocation() {
        uni.getLocation({
          type: 'gcj02',
          success: (res) => {
            this.address = `经度:${res.longitude} 纬度:${res.latitude}`
          },
          fail: () => {
            this.address = '定位失败'
          },
        })
      },

      // 状态改变
      onStateChange(e) {
        console.log('相机状态:', e)
        if (e.detail.code === 1007) {
          this.camerastate = true
        } else if (e.detail.code === -1301) {
          this.camerastate = false
        }
      },

      // 拍照
      takePhoto() {
        // 震动
        uni.vibrateShort({
          success: function () {
            console.log('震动成功')
          },
          fail: function (err) {
            console.log('震动失败', err)
          }
        })

        // 拍照
        if (this.livePusher) {
          this.livePusher.snapshot({
            quality: 100, // 最高质量
            success: (e) => {
              console.log('拍照成功', e);
              // 注意：在某些平台，快照结果在e.tempImagePath属性中
              const imageUrl = e.tempImagePath || e.message?.tempImagePath;
              if (imageUrl) {
                this.previewImage = imageUrl;
                this.originalImage = imageUrl;

                
                // 在预览模式下暂时禁用相机，以便用户可以查看预览
                this.enableCamera = false;

                this.goToPreview();
              } else {
                uni.showToast({
                  title: '拍照失败，请重试',
                  icon: 'none'
                });
              }
            },
            fail: (err) => {
              console.error('拍照失败', err);
              uni.showToast({
                title: '拍照失败:' + JSON.stringify(err),
                icon: 'none'
              });
            }
          })
        } else {
          uni.showToast({
            title: '相机未就绪',
            icon: 'none'
          });
        }
      },

      // 去预览页面
      goToPreview() {
        // 跳转到预览页面，传递数据
        uni.navigateTo({
          url: `/pages/picture/PreviewPhoto?userInfo=${encodeURIComponent(JSON.stringify(this.userInfo))}&currentTime=${encodeURIComponent(this.currentTime)}&address=${encodeURIComponent(this.address)}&originalImage=${encodeURIComponent(this.originalImage)}`,
          success: () => {
            console.log('跳转到预览页面成功');
          },
          fail: (err) => {
            console.error('跳转到预览页面失败', err);
            uni.showToast({
              title: '页面跳转失败',
              icon: 'none'
            });
          }
        });
      },

      // 处理从PreviewPhoto返回的结果
      handlePreviewResult(resultData) {
        // 当从PreviewPhoto返回时，使用带水印的照片数据
        const checkinData = {
          originalImage: resultData.originalImage,
          watermarkedImage: resultData.watermarkedImage,
          watermark: resultData.watermark,
          timestamp: resultData.timestamp,
        };

        if (this.fromPage === 'checkin') {
          uni.navigateBack({
            delta: 1,
            success: () => {
              uni.$emit('checkinSuccess', checkinData)
            },
          })
        } else {
          uni.showToast({
            title: '照片已保存',
            icon: 'success',
          })
          setTimeout(() => {
            uni.navigateBack()
          }, 1000)
        }
      },
    },
  }
</script>

  <style lang="scss" scoped>
  .view_page {
    justify-content: center;
    align-items: center;
    background-color: #000;

    .h5-camera-placeholder {
      flex: 1;
      z-index: 10;
      align-items: center;
      justify-content: center;
      font-size: 32rpx;
      color: #ffffff;
    }

    .preview-image {
      position: absolute;
      left: 0;
      top: 0;
      flex: 1;
      z-index: 10;
      object-fit: cover;
    }

    .view_container {
      position: absolute;
      top: 0;
      left: 0;
      align-items: center;
      justify-content: space-between;

      .watermark {
        position: absolute;
        top: 10rpx;
        right: 10rpx;
        z-index: 20;

        .watermark-item {
          margin-bottom: 12rpx;
          color:rgb(238, 242, 6);
          font-size: 28rpx;
          text-align: right;
        }
      }

      .control-bar {
        position: absolute;
        left: 0;
        bottom: 0;
        z-index: 30;
        width: 750rpx;
        height: 400rpx;
        flex-direction: row;
        align-items: center;
        justify-content: space-around;

        .btn {
          display: flex;
          align-items: center;
          justify-content: center;

          &.empty-btn {
            width: 80rpx;
            height: 80rpx;
          }

          &.flip-btn {
            width: 80rpx;
            height: 80rpx;
          }

          &.take-btn {
            width: 140rpx;
            height: 140rpx;
          }
        }

      }
    }
  }
</style>